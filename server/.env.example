PORT=5000
NODE_ENV=development
# For local development: mongodb://127.0.0.1:27017/medsync
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medsync?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medsync

# Cryptographically secure random JWT secret (min 32 chars)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# 256-bit AES-256-GCM encryption key as a 64-character hex string
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend client URL for CORS and cookie origin
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API configuration (called ONLY from the backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
